# 复制为项目根目录的 cloud.env 并按实际填写：
#   cp deploy/cloud.env.example cloud.env
#
# 域名（可选）。两种走法：
#   1) 填域名：把 A 记录指向服务器公网 IP，Caddy 自动申请 HTTPS 证书，走 https://<域名>
#   2) 留空：只用公网 IP / 局域网地址访问，仅明文 HTTP、无证书
#      （deploy/server/*.sh 会自动叠加 docker-compose.cloud.nodomain.yml；
#       手工执行 docker compose 时需自行加上该 -f 覆盖文件，见 DEPLOY.md）
GCT_DOMAIN=quant.example.com

# 监听器接受哪些「访问地址」（默认为 any，即不写死任何地址）：
#   any      —— 域名、公网 IP、局域网地址都能访问（服务器部署推荐；非显式信任来源一律 403）
#   loopback —— 只允许本机回环 + GCT_ALLOWED_HOSTS 里显式列出的地址（桌面本机部署）
#   lan      —— 回环 + 本机网卡上的局域网地址（手机连同一网络时用）
GCT_HOST_ACCESS=any

# 可选：显式收紧来源（逗号分隔，会叠加在 GCT_HOST_ACCESS 之上）。
# 注意：这两项必须同时出现在 docker-compose.cloud.yml 的 environment 块里才会传进容器
# （该文件已声明）；只写在 cloud.env 而不在 compose 里声明是不会生效的。
# GCT_ALLOWED_HOSTS=quant.example.com,203.0.113.10
# GCT_ALLOWED_ORIGINS=https://quant.example.com,http://203.0.113.10

# 可选：浏览器来源（单值）。仅在有域名时才需要；留空则由后端自适应（同源请求按 Host 头判定，
# 域名 / 公网 IP 都能正常访问）。install.sh 填了域名时会自动写入 https://<域名>。
# GCT_FRONTEND_ORIGIN=https://quant.example.com

# 操作员登录用户名
GCT_AUTH_USERNAME=Belttz

# 首次启动的种子密码（之后请在网页「设置 → 账户安全」里修改，改完此处可清空）
GCT_AUTH_PASSWORD=
